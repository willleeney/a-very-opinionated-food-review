{
  "name": "tastefull",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm --filter @tastefull/web dev",
    "build": "pnpm --filter @tastefull/web build",
    "preview": "pnpm --filter @tastefull/web preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "seed:users": "node scripts/seed-users.mjs",
    "seed:dev": "node scripts/seed-dev.mjs",
    "screenshots": "tsx e2e/capture-screens.ts",
    "lint": "eslint packages --ext .ts,.tsx",
    "typecheck": "pnpm --filter @tastefull/web typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@neondatabase/serverless": "^1.1.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "dotenv": "^17.2.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^27.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
