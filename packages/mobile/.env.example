# Base URL of the deployed web app, used for Better Auth and the /api/data routes.
# Must be an absolute origin — the mobile app is not served from the same host.
# Android emulator reaches the host machine's localhost via 10.0.2.2.
VITE_AUTH_URL=http://10.0.2.2:4321

# Google Maps API key (used for place lookup / maps)
VITE_GOOGLE_MAPS_API_KEY=
