# IMPORTANT: server-side vars belong in packages/web/.dev.vars, NOT here.
# Astro's server routes read them via `context.locals.runtime.env`, which the
# Cloudflare adapter populates from .dev.vars. This file only feeds
# `import.meta.env` (i.e. the PUBLIC_* vars used by client code).
# In production these come from `wrangler secret put`.
#
# packages/web/.dev.vars needs:
#   DATABASE_URL, BETTER_AUTH_SECRET, BETTER_AUTH_URL,
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET

# Better Auth + Neon
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:4321
PUBLIC_AUTH_URL=http://localhost:4321

# Google Places API (for restaurant search in Add Place)
PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# OAuth (optional — omit to disable social login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cloudflare (deployment only — set in CI secrets, not locally)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
